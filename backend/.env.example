# Copy to backend/.env for local development (never commit .env).
# In the cloud, set these as secret environment variables on the host instead.

# --- Server ---
PORT=8080
# HOST defaults to 127.0.0.1 in dev and 0.0.0.0 when NODE_ENV=production
# NODE_ENV=production
# Number of reverse proxies in front of the app (Render / Cloud Run = 1)
TRUST_PROXY=0

# --- Firebase (Spark/free plan is enough) ---
# Project ID from Firebase console -> Project settings. Required unless AUTH_DISABLED=true.
FIREBASE_PROJECT_ID=
# Service account key (Project settings -> Service accounts -> Generate new private key),
# pasted as one-line JSON or base64. Enables durable per-user quotas in Firestore.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Local development ONLY: skip login (refused when NODE_ENV=production or HOST is not loopback)
AUTH_DISABLED=false

# --- AI providers (configure at least one) ---
# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Comma-separated model ids (defaults to gemini-flash-latest,gemini-flash-lite-latest)
# GEMINI_MODELS=gemini-flash-latest,gemini-flash-lite-latest

# Optional: any OpenAI-compatible endpoint (9Router, OpenRouter, Groq, Ollama ...)
# OPENAI_COMPAT_BASE_URL=http://127.0.0.1:20128/v1
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_LABEL=9Router
# Append :vision to models that accept images
# OPENAI_COMPAT_MODELS=gpt-4o-mini:vision,llama-3.3-70b

# --- Limits ---
DAILY_REQUEST_LIMIT=100
RATE_LIMIT_PER_MINUTE=20
MAX_IMAGE_BYTES=4194304
MAX_IMAGES=4
UPSTREAM_TIMEOUT_MS=90000
