{
  "name": "intellipointer-desktop",
  "productName": "IntelliPointer AI",
  "version": "0.1.0",
  "private": true,
  "description": "Windows desktop assistant: mark anything on screen, ask an AI about it, get a streamed answer in a floating panel.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "check": "node scripts/check.js",
    "test": "node --test test/*.test.js",
    "icons": "node scripts/build-icons.js",
    "report": "electron ../docs/tools/build-report.js",
    "latex": "node ../docs/tools/build-latex.js && node ../docs/tools/check-latex.js",
    "diagrams": "electron ../docs/tools/svg-to-png.js ../docs/architecture.svg ../docs/sequence.svg",
    "app:build": "node scripts/install-app.mjs --build-only",
    "app:install": "node scripts/install-app.mjs"
  },
  "dependencies": {
    "@highlightjs/cdn-assets": "^11.12.0",
    "dompurify": "^3.4.17",
    "marked": "^18.1.2",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^45.0.0",
    "lucide-static": "^1.61.0"
  }
}
