{
  "name": "intellipointer-desktop",
  "productName": "IntelliPointer AI",
  "version": "0.1.0",
  "private": true,
  "description": "Windows desktop assistant: mark anything on screen, ask an AI about it, get a streamed answer in a floating panel.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --win portable"
  },
  "build": {
    "appId": "dev.intellipointer.desktop",
    "files": [
      "src/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "src/main/native/**"
    ],
    "win": {
      "target": "portable"
    }
  },
  "dependencies": {
    "@highlightjs/cdn-assets": "^11.12.0",
    "dompurify": "^3.4.17",
    "marked": "^18.1.2",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "electron": "^45.0.0"
  }
}
