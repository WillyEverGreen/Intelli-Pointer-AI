rules_version = '2';

// IntelliPointer only touches Firestore from the backend through the Admin
// SDK (which bypasses these rules). Clients get no direct access at all, so a
// leaked Firebase web config cannot read or tamper with quota/usage data.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
